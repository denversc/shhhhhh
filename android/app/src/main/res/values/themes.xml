<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Shhhhhh" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Window background matching Compose Material 3 light theme -->
        <item name="android:windowBackground">@color/window_background</item>

        <!-- Splash screen background and transparent 1x1 icon for zero flicker -->
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>

        <!-- Seamless window navigation and status bar attributes -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>